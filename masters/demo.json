  "aftercare": [
    {
      "step": "Keep them dry for 24 hours",
      "text": "No water, steam, sauna or sweaty workouts while the adhesive cures."
    },
    {
      "step": "Cleanse every day",
      "text": "Wash gently with an oil-free lash shampoo and a soft brush. Clean lashes last longer."
    },
    {
      "step": "Brush each morning",
      "text": "Use a clean spoolie to fluff them back into place once they're dry."
    },
    {
      "step": "Skip oils and mascara",
      "text": "Oil-based removers, creams and waterproof mascara break down the bond."
    },
    {
      "step": "Hands off",
      "text": "Don't rub, pick or pull. If a lash is bothering you, message us instead."
    },
    {
      "step": "Book your fill",
      "text": "Come back every 2–3 weeks to keep your set looking full."
    }
  ],
